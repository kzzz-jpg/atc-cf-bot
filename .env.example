DISCORD_BOT_TOKEN=replace-with-discord-bot-token
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=replace-with-your-model
DATABASE_URL=postgres://atc_bot:replace-with-local-password@localhost:5432/atc_bot?sslmode=disable
# Explicit local development TLS exception only.
DATABASE_ALLOW_INSECURE_LOCAL=true
POSTGRES_PASSWORD=replace-with-local-password
